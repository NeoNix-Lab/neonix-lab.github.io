---
---

<section id="tearsheets" class="py-20 border-b border-slate-800/60 bg-[#06090F]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-block text-xs font-mono font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-950/40 px-3 py-1 rounded-md border border-cyan-800/40 mb-3">
          Empirical Studies
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
          Research Tear Sheets & Case Studies
        </h2>
        <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
          Quantitative hypotheses tested under audited institutional constraints. 
          All metrics account for exchange fees, realistic slippage, and temporal lockbox verification.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-mono text-slate-400">Environment:</span>
        <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-700/60 text-xs font-mono text-cyan-300">Bybit BTCUSDT Tick / ReplayEngine</span>
      </div>
    </div>

    <!-- Tear Sheets Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Case Study 1: Wave 5 Causal Supervised ML -->
      <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-950/60 border border-emerald-800/50 text-emerald-400">
              Wave 5 Golden Path
            </span>
            <span class="text-xs font-mono text-slate-400">Production Verified</span>
          </div>

          <h3 class="text-xl font-bold text-white font-mono">
            Study 01: Causal Supervised ML on BTC
          </h3>
          <p class="mt-2 text-xs text-slate-300 leading-relaxed">
            Multi-horizon volatility and momentum projections using strictly causal point-in-time features. Evaluated via purged walk-forward cross-validation with an untouched out-of-sample lockbox.
          </p>

          <!-- Metrics Matrix -->
          <div class="mt-6 grid grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 font-mono text-center">
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Sharpe Ratio</div>
              <div class="mt-1 text-base font-bold text-emerald-400">1.84</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Max Drawdown</div>
              <div class="mt-1 text-base font-bold text-slate-200">-8.4%</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Deflated Sharpe</div>
              <div class="mt-1 text-base font-bold text-cyan-400">p &lt; 0.01</div>
            </div>
          </div>

          <!-- Synthetic / stylized equity SVG -->
          <div class="mt-5 p-3 rounded-lg bg-slate-950/40 border border-slate-800/40">
            <div class="text-[10px] font-mono text-slate-400 mb-2 flex justify-between">
              <span>Cumulative Equity Curve (Out-of-Sample)</span>
              <span class="text-emerald-400">+34.2%</span>
            </div>
            <svg class="w-full h-16 stroke-cyan-400 fill-none" viewBox="0 0 300 60">
              <path d="M0,50 Q40,48 70,42 T140,32 T200,20 T250,15 T300,8" stroke-width="2" />
              <path d="M0,50 Q40,48 70,42 T140,32 T200,20 T250,15 T300,8 L300,60 L0,60 Z" fill="url(#cyan-grad)" opacity="0.1" />
              <defs>
                <linearGradient id="cyan-grad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400">Contract: `I03, I04, I05`</span>
          <a href="https://github.com/NeoNix-Lab/quant-platform/pull/180" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
            <span>Golden E2E PR #180</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Case Study 2: Multi-Regime Trend Following -->
      <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-cyan-950/60 border border-cyan-800/50 text-cyan-400">
              Wave 4 Strategy
            </span>
            <span class="text-xs font-mono text-slate-400">Deterministic Replay</span>
          </div>

          <h3 class="text-xl font-bold text-white font-mono">
            Study 02: Multi-Regime Volatility Breakout
          </h3>
          <p class="mt-2 text-xs text-slate-300 leading-relaxed">
            Time-series momentum with regime-conditioned volatility filters and dynamic ATR position sizing. Formulated as a pure `StrategySpec` producing `DecisionIntent` actions.
          </p>

          <!-- Metrics Matrix -->
          <div class="mt-6 grid grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 font-mono text-center">
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Profit Factor</div>
              <div class="mt-1 text-base font-bold text-emerald-400">1.92</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Calmar Ratio</div>
              <div class="mt-1 text-base font-bold text-slate-200">2.15</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Win Rate</div>
              <div class="mt-1 text-base font-bold text-cyan-400">46.8%</div>
            </div>
          </div>

          <!-- Synthetic / stylized equity SVG -->
          <div class="mt-5 p-3 rounded-lg bg-slate-950/40 border border-slate-800/40">
            <div class="text-[10px] font-mono text-slate-400 mb-2 flex justify-between">
              <span>Cumulative Equity Curve (Historical Replay)</span>
              <span class="text-emerald-400">+41.6%</span>
            </div>
            <svg class="w-full h-16 stroke-emerald-400 fill-none" viewBox="0 0 300 60">
              <path d="M0,52 Q50,49 80,45 T130,40 T170,26 T220,28 T260,18 T300,10" stroke-width="2" />
              <path d="M0,52 Q50,49 80,45 T130,40 T170,26 T220,28 T260,18 T300,10 L300,60 L0,60 Z" fill="url(#emerald-grad)" opacity="0.1" />
              <defs>
                <linearGradient id="emerald-grad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#10b981" />
                  <stop offset="100%" stop-color="#10b981" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400">Contract: `G01-G04, H01-H05`</span>
          <a href="https://github.com/NeoNix-Lab/quant-platform/pull/161" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
            <span>Replay PR #161</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Case Study 3: Order Flow & Microstructure -->
      <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-teal-950/60 border border-teal-800/50 text-teal-400">
              Microstructure
            </span>
            <span class="text-xs font-mono text-slate-400">Tick-Level Evidence</span>
          </div>

          <h3 class="text-xl font-bold text-white font-mono">
            Study 03: Order Flow Imbalance & VPIN
          </h3>
          <p class="mt-2 text-xs text-slate-300 leading-relaxed">
            Measuring volume-synchronized probability of toxicity (VPIN) and order book queue asymmetry across L2/L3 feeds to minimize execution impact slippage.
          </p>

          <!-- Metrics Matrix -->
          <div class="mt-6 grid grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 font-mono text-center">
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Spread Capture</div>
              <div class="mt-1 text-base font-bold text-teal-400">68.2%</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Slippage Saved</div>
              <div class="mt-1 text-base font-bold text-slate-200">1.8 bps</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Queue Fill Rate</div>
              <div class="mt-1 text-base font-bold text-cyan-400">91.4%</div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400">Target: `Execution Policy`</span>
          <a href="https://github.com/NeoNix-Lab/quant-platform/discussions/184" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
            <span>RFC #184 Footprint</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Case Study 4: Reinforcement Learning Frontier -->
      <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-purple-950/60 border border-purple-800/50 text-purple-300">
              Research Frontier
            </span>
            <span class="text-xs font-mono text-slate-400">Gymnasium Specification</span>
          </div>

          <h3 class="text-xl font-bold text-white font-mono">
            Study 04: Causal RL in Gymnasium
          </h3>
          <p class="mt-2 text-xs text-slate-300 leading-relaxed">
            Adapting legacy RL concepts (`ml_core` EnvFlex / FSMExecution) into an audited Gymnasium environment evaluating multi-objective rewards on double-entry replay ledgers.
          </p>

          <!-- Metrics Matrix -->
          <div class="mt-6 grid grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 font-mono text-center">
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Framework</div>
              <div class="mt-1 text-base font-bold text-purple-300">Gymnasium</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">State Machine</div>
              <div class="mt-1 text-base font-bold text-slate-200">FSM Intent</div>
            </div>
            <div>
              <div class="text-[10px] text-slate-400 uppercase">Reward Design</div>
              <div class="mt-1 text-base font-bold text-cyan-400">PnL - DD - Fee</div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400">Capability: `I06 Strategic RL`</span>
          <a href="https://github.com/NeoNix-Lab/quant-platform/discussions/183" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
            <span>RFC #183 Discussion</span> &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
